# Notion Integration
NOTION_API_KEY=ntn_your_notion_integration_token_here

# Dedicated Database ID for Discovered Job Leads / Inbox:
NOTION_DISCOVERED_JOBS_DB_ID=your_32_character_discovered_jobs_database_id

